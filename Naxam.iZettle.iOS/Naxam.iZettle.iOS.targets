<?xml version="1.0" encoding="UTF-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_iZettleSDKAssemblyName>Naxam.iZettle.iOS, Version=4.53.1, Culture=neutral, PublicKeyToken=null</_iZettleSDKAssemblyName>
		<_iZettleSDKItemsFolder>iZettleSDK-4.53.1</_iZettleSDKItemsFolder>
		<_iZettleSDKSDKBaseFolder>$(XamarinBuildDownloadDir)$(_iZettleSDKItemsFolder)\</_iZettleSDKSDKBaseFolder>
	</PropertyGroup>
	<ItemGroup Condition="('$(OutputType)'!='Library' OR '$(IsAppExtension)'=='True')">
		<XamarinBuildDownload Include="$(_iZettleSDKItemsFolder)">      
			<Url>https://github.com/iZettle/sdk-ios/releases/download/4.53.1/iZettleSDK.zip</Url>
			<Kind>Zip</Kind>
		</XamarinBuildDownload>
		<NativeReference Include="$(_iZettleSDKSDKBaseFolder)iZettleSDK/iZettleSDK.xcframework">
			<Kind>Framework</Kind>
			<SmartLink>True</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
		<NativeReference Include="$(_iZettleSDKSDKBaseFolder)iZettleSDK/iZettlePayments.xcframework">
			<Kind>Framework</Kind>
			<SmartLink>True</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
		<NativeReference Include="$(_iZettleSDKSDKBaseFolder)iZettleSDK/PPRiskMagnes.xcframework">
			<Kind>Framework</Kind>
			<SmartLink>True</SmartLink>
			<ForceLoad>True</ForceLoad>
		</NativeReference>
	</ItemGroup>
</Project>